{
  "name": "@daffa/photography",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "tsx scripts/build-catalog.ts",
    "samples": "node scripts/create-samples.mjs",
    "dev": "npm run catalog && next dev --hostname 127.0.0.1 --port 3002",
    "build": "npm run catalog && next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "typecheck": "npm run catalog && tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}

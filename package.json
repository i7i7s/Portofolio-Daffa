{
  "name": "daffa-sites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @daffa/portfolio",
    "dev:photo": "npm run dev -w @daffa/photography",
    "build": "npm run build --workspaces",
    "build:portfolio": "npm run build -w @daffa/portfolio",
    "build:photo": "npm run build -w @daffa/photography",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  }
}
